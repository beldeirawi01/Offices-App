VITE_API_BASE_URL=http://localhost:4000/api
# Base URL this dashboard is served from — used only to build the
# client-facing invoice link shown to the owner (cosmetic display, the real
# link is generated by the backend using its own APP_BASE_URL).
VITE_APP_BASE_URL=http://localhost:5173
