# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/offices_app

# Voice transcription (Whisper via OpenAI API)
OPENAI_API_KEY=

# Structured extraction (Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Client delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

BREVO_API_KEY=
BREVO_FROM_EMAIL=

# Payments (Stripe Connect — each business gets its own connected account,
# see the "Stripe Connect" section in README.md)
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint scoped to "Your account" in the
# Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=
# Signing secret for a SEPARATE webhook endpoint scoped to "Connected
# accounts" — same URL is fine, but Stripe issues each scope its own secret.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Flat $29/month Jobscribe subscription (separate from Stripe Connect above —
# this bills YOUR users, not their clients). Create a recurring $29.00/month
# Price in the Stripe Dashboard and put its id here — see "Subscription
# billing" in README.md.
STRIPE_SUBSCRIPTION_PRICE_ID=

# Public URL of the dashboard/app (used to build links)
APP_BASE_URL=http://localhost:5173

# Comma-separated origins allowed to call this API in production
# (e.g. https://app.yourdomain.com). Leave blank in development.
ALLOWED_ORIGINS=

# Object storage for recorded voice notes (S3-compatible: AWS S3, Cloudflare
# R2, Backblaze B2). Leave all blank to fall back to local disk in dev only —
# do NOT run in production without this, most hosts wipe local disk on deploy.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Error tracking (https://sentry.io) — optional, no-op if left blank
SENTRY_DSN=
