# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/offices_app

# Voice transcription (Whisper via OpenAI API)
OPENAI_API_KEY=

# Structured extraction (Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Client delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public URL of the dashboard/app (used to build links)
APP_BASE_URL=http://localhost:5173
