generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  TECH
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  CONVERTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DeliveryChannel {
  SMS
  EMAIL
}

enum DocumentationStage {
  ARRIVAL
  MID_JOB
  COMPLETION
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  // Sales tax rate as a decimal fraction (e.g. 0.0825 for 8.25%), applied to
  // every invoice's subtotal. Owner-configurable from Settings.
  taxRate   Float    @default(0)
  // IANA timezone (e.g. "America/Chicago") this org operates in. Scheduled
  // reminders/review requests are sent based on the local hour here, not the
  // server's clock, so a client in Arizona isn't texted at 6am.
  timezone  String   @default("America/New_York")

  // Stripe Connect — each business gets its own connected account so client
  // payments settle to their bank account, not ours. Populated once the
  // owner completes Stripe's hosted onboarding from Settings.
  stripeAccountId        String?
  stripeChargesEnabled   Boolean @default(false)
  stripePayoutsEnabled   Boolean @default(false)
  stripeDetailsSubmitted Boolean @default(false)

  // Automatic follow-up: ask for a review some days after an invoice is
  // paid, and nudge recurring-service clients to rebook when their job
  // type's typical interval has passed. Both are org-wide defaults that a
  // client's own `followUpsEnabled` can override to opt them out entirely.
  reviewRequestEnabled      Boolean @default(true)
  reviewRequestDelayDays    Int     @default(3)
  reviewLinkUrl             String?
  rebookingRemindersEnabled Boolean @default(true)

  // Platform billing — a flat $29/month subscription for using Jobscribe
  // itself (separate from stripeAccountId above, which is the business's
  // OWN connected account for receiving client payments). New orgs start on
  // a 14-day trial (trialEndsAt set at registration); orgs that existed
  // before this field was added get NULL, which is treated as "still
  // allowed" (see requireActiveSubscription) rather than retroactively
  // locking out anyone already using the app.
  subscriptionStatus           SubscriptionStatus @default(TRIALING)
  stripeCustomerId             String?
  stripeSubscriptionId         String?
  trialEndsAt                  DateTime?
  subscriptionCurrentPeriodEnd DateTime?

  // Sequential, per-business invoice/quote numbers (INV-000001, QTE-000001,
  // ...) rather than a timestamp+random string — trades are used to
  // sequential paper invoice books and expect gaps to mean something.
  // Incremented via an atomic `UPDATE ... SET x = x + 1 RETURNING x`
  // (Prisma's `{ increment: 1 }`), so two invoices created at the same
  // instant still get distinct numbers — Postgres serializes concurrent
  // updates to the same row instead of losing one.
  invoiceSequence Int @default(0)
  quoteSequence   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  clients  Client[]
  jobs     Job[]
  invoices Invoice[]
  quotes   Quote[]
}

model User {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  email          String       @unique
  passwordHash   String
  role           UserRole     @default(TECH)
  phone          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  jobs Job[] @relation("AssignedTech")
}

model Client {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  email          String?
  phone          String?
  // TCPA-style consent to receive SMS at `phone`. Required before we text
  // invoices/reminders to this number — collected explicitly, not assumed.
  smsConsent     Boolean      @default(false)
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  notes          String?
  // Owner-controlled opt-out of automatic review requests and rebooking
  // reminders for this specific client, without turning them off org-wide.
  followUpsEnabled Boolean    @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  jobs     Job[]
  invoices Invoice[]
  quotes   Quote[]

  @@index([organizationId])
}

model Job {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  client         Client       @relation(fields: [clientId], references: [id])
  clientId       String
  assignedTech   User?        @relation("AssignedTech", fields: [assignedTechId], references: [id])
  assignedTechId String?
  title          String
  jobType        String?
  status         JobStatus    @default(SCHEDULED)
  scheduledAt    DateTime?
  completedAt    DateTime?
  addressLine1   String?
  city           String?
  state          String?
  postalCode     String?
  // How often this type of job typically needs redoing (e.g. 6 for an HVAC
  // tune-up), used to schedule a rebooking reminder that many months after
  // completion. Null means "not a recurring job type" — no reminder is sent.
  recurrenceIntervalMonths Int?
  rebookingReminderSentAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  voiceNotes    VoiceNote[]
  invoice       Invoice?
  quote         Quote?
  documentation JobDocumentation[]

  @@index([organizationId])
  @@index([clientId])
  @@index([assignedTechId])
}

model VoiceNote {
  id             String   @id @default(cuid())
  job            Job      @relation(fields: [jobId], references: [id])
  jobId          String
  audioUrl       String
  // Once the pipeline successfully reaches EXTRACTED (a quote/invoice has
  // been drafted from it), the audio file itself is deleted — the transcript
  // above is kept as the durable record, but there's no ongoing reason to
  // keep the client's raw recording once it's been turned into structured
  // billing data (nothing in the app ever plays it back). Left in place on
  // FAILED so a failed extraction can still be retried/debugged from the
  // original audio. `audioUrl` is kept as a historical reference even after
  // deletion (the key it WAS at), not re-resolvable once audioDeleted is true.
  audioDeleted   Boolean  @default(false)
  transcript     String?
  extractedJson  Json?
  // Claude's raw text response, before JSON parsing/validation — kept even
  // when extraction fails so a bad/hallucinated result can be debugged from
  // what the model actually said.
  rawExtraction  String?
  status         String   @default("UPLOADED") // UPLOADED, TRANSCRIBING, TRANSCRIBED, EXTRACTING, EXTRACTED, FAILED
  errorMessage   String?
  // QUOTE (pre-job estimate, spoken on arrival) or INVOICE (post-job actuals,
  // spoken on completion) — routes to a different Claude extraction prompt
  // and drafts a Quote vs an Invoice. Defaults to INVOICE for backward
  // compatibility with recordings made before quotes existed.
  purpose        String   @default("INVOICE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// A photo + voice-note pair captured at a specific point in the job —
// arrival, mid-job, or completion — kept separate from the general
// VoiceNote/Job-note timeline as retrievable evidence for a liability
// dispute or warranty claim, not as billing input.
model JobDocumentation {
  id              String             @id @default(cuid())
  job             Job                @relation(fields: [jobId], references: [id])
  jobId           String
  stage           DocumentationStage
  photoStorageKey String
  audioStorageKey String?
  transcript      String?
  latitude        Float?
  longitude       Float?
  // Owner-approved to appear on the client-facing invoice (e.g. a before/after
  // pair) — defaults to internal-only, since most captures are just evidence.
  clientFacing    Boolean            @default(false)
  status          String             @default("UPLOADED") // UPLOADED, TRANSCRIBING, TRANSCRIBED, FAILED — only meaningful when audioStorageKey is set
  errorMessage    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([jobId])
}

model Invoice {
  id             String        @id @default(cuid())
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  client         Client        @relation(fields: [clientId], references: [id])
  clientId       String
  job            Job?          @relation(fields: [jobId], references: [id])
  jobId          String?       @unique
  // Unique per-organization (not globally) — two different businesses both
  // legitimately start at INV-000001, so the constraint has to include
  // organizationId or the second business's first invoice would collide
  // with the first's.
  invoiceNumber  String
  // Unguessable token used to build the client-facing invoice/payment link,
  // so clients can view and pay without an account and without exposing the
  // sequential/internal invoice id. A UUID (not cuid) deliberately — cuid
  // embeds a timestamp and is optimized for sortability, not unguessability.
  publicToken    String        @unique @default(uuid())
  status         InvoiceStatus @default(DRAFT)
  laborHours     Float?
  // Money fields are Decimal (exact, base-10), never Float — a client
  // shouldn't see $149.9800000000001 because of binary floating-point
  // rounding. Serialized back to a plain JSON number for API responses via
  // the global Decimal.prototype.toJSON patch in db/prisma.ts.
  laborRate      Decimal?      @db.Decimal(12, 2)
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  dueDate        DateTime?
  sentAt         DateTime?
  paidAt         DateTime?
  lastReminderAt DateTime?
  reviewRequestSentAt DateTime?
  stripePaymentLinkId String?
  stripePaymentLinkUrl String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lineItems LineItem[]
  payments  Payment[]
  deliveries InvoiceDelivery[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([clientId])
}

model LineItem {
  id          String   @id @default(cuid())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  description String
  quantity    Float    @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  kind        String   @default("PART") // PART or LABOR
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model Quote {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  client         Client       @relation(fields: [clientId], references: [id])
  clientId       String
  job            Job?         @relation(fields: [jobId], references: [id])
  jobId          String?      @unique
  // Unique per-organization, not globally — see Invoice.invoiceNumber.
  quoteNumber    String
  // Unguessable token for the client-facing quote page (view + accept/decline),
  // same pattern as Invoice.publicToken.
  publicToken    String       @unique @default(uuid())
  status         QuoteStatus  @default(DRAFT)
  laborHours     Float?
  laborRate      Decimal?     @db.Decimal(12, 2)
  subtotal       Decimal      @default(0) @db.Decimal(12, 2)
  tax            Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @default(0) @db.Decimal(12, 2)
  notes          String?
  sentAt         DateTime?
  respondedAt    DateTime?
  // Set once a tech marks the job complete (or the owner manually converts)
  // and this quote becomes an invoice — never re-converted after that.
  convertedInvoiceId String?  @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lineItems  QuoteLineItem[]
  deliveries QuoteDelivery[]

  @@unique([organizationId, quoteNumber])
  @@index([organizationId])
  @@index([clientId])
}

model QuoteLineItem {
  id          String   @id @default(cuid())
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId     String
  description String
  quantity    Float    @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  kind        String   @default("PART") // PART or LABOR
  createdAt   DateTime @default(now())

  @@index([quoteId])
}

model QuoteDelivery {
  id           String          @id @default(cuid())
  quote        Quote           @relation(fields: [quoteId], references: [id])
  quoteId      String
  channel      DeliveryChannel
  recipient    String
  success      Boolean
  errorMessage String?
  createdAt    DateTime        @default(now())

  @@index([quoteId])
}

model Payment {
  id              String        @id @default(cuid())
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  invoiceId       String
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(PENDING)
  stripePaymentIntentId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([invoiceId])
}

model InvoiceDelivery {
  id        String          @id @default(cuid())
  invoice   Invoice         @relation(fields: [invoiceId], references: [id])
  invoiceId String
  channel   DeliveryChannel
  recipient String
  success   Boolean
  errorMessage String?
  createdAt DateTime        @default(now())

  @@index([invoiceId])
}

// Records every Stripe event id we've started processing, from both the
// platform webhook and the Connect webhook (event ids are globally unique
// across both streams). Inserting this row is how we atomically claim an
// event: a duplicate delivery's insert hits the unique constraint on `id`
// and is skipped, closing the race a plain "does a Payment already exist"
// check can't — two concurrent deliveries can both pass that check before
// either has written its Payment row.
model StripeWebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}
