{
  "expo": {
    "name": "Offices App",
    "slug": "offices-app-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#111827"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "We need microphone access so you can record a voice note describing the job you just finished."
      }
    },
    "android": {
      "permissions": ["RECORD_AUDIO"],
      "package": "com.officesapp.mobile"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:4000/api"
    }
  }
}
